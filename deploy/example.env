# Public DNS name pointed at this server. Caddy obtains and renews TLS.
DOMAIN=chess.example.com

# Each WebSocket connection may send this many protocol requests per 10 seconds.
CHESS_RATE_LIMIT_PER_10S=60

# The public port for `ssh <DOMAIN>`. Keep 22 so players need no -p flag, and
# move the host's own sshd elsewhere (see deploy/README.md).
SSH_PORT=22

# Visitors playing over SSH at once; each runs its own client process of
# about 25 MB, so keep this within CHESS_MEMORY.
CHESS_SSH_MAX_SESSIONS=60

# Games one address may have open at once, so one visitor cannot take every
# seat. Several people behind one office or university network share an
# address, so leave some room.
CHESS_SSH_MAX_PER_IP=3

# The most the chess server may use, for sharing the host with other work.
CHESS_CPUS=2
CHESS_MEMORY=2g

# Structured application log level.
RUST_LOG=chess_server=info
