{$DOMAIN} {
    encode zstd gzip

    @websocket path /ws
    reverse_proxy @websocket chess-server:3000
    reverse_proxy /health chess-server:3000

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
        -Server
    }

    log {
        output stdout
        format json
    }
}
